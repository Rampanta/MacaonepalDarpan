async function loadAllNews() {
  const newsContainer = document.getElementById('auto-news-container');
  const nepseContainer = document.getElementById('nepse-news-container');
  
  if (!newsContainer) return;

  try {
    // Load main news
    const res = await fetch('./news.json?v=' + Date.now());
    const data = await res.json();
    
    newsContainer.innerHTML = data.news.map(item => `
      <article class="news-card">
        <span class="source-badge">${item.source}</span>
        <h3><a href="${item.link}" target="_blank">${item.title}</a></h3>
        <p>${item.summary}...</p>
        <time>${item.published}</time>
      </article>
    `).join('');

    // Load NEPSE
    if (nepseContainer) {
      const nepseRes = await fetch('./nepse.json?v=' + Date.now());
      const nepseData = await nepseRes.json();
      
      nepseContainer.innerHTML = `
        <div class="nepse-grid">
          ${nepseData.indices.map(i => `
            <div class="nepse-item ${parseFloat(i.change) >= 0 ? 'up' : 'down'}">
              <strong>${i.name}</strong>
              <span>${i.value}</span>
              <small>${i.change}</small>
            </div>
          `).join('')}
        </div>
        <small class="updated">Updated: ${new Date(nepseData.updated).toLocaleString('ne-NP')}</small>
      `;
    }

  } catch (err) {
    console.error('News load failed:', err);
    newsContainer.innerHTML = '<p>समाचार लोड हुन सकेन। पछि प्रयास गर्नुहोस्।</p>';
  }
}

// Auto load on page load
document.addEventListener('DOMContentLoaded', loadAllNews);
// Refresh every 5 min
setInterval(loadAllNews, 5 * 60 * 1000);